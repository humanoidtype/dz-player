# Client environment — contoh. Salin ke client/.env bila perlu override.
# Default APK: https://dz-player.dzfee.id (sudah dibake di build)
# Contoh override untuk dev terhadap server lokal:
# VITE_API_BASE_URL=http://localhost:3000

# Google OAuth client ID untuk tombol login (wajib agar fitur login aktif).
# Ambil dari https://console.cloud.google.com → Credentials → OAuth 2.0 Client ID (Web)
VITE_GOOGLE_CLIENT_ID=
